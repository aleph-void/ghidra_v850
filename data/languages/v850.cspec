      <entry size="2" alignment="2"/>
      <entry size="4" alignment="4"/>
      <entry size="8" alignment="4"/>
    </size_alignment_map>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="sp" space="ram" growth="negative"/>

  <prefersplit style="inhalf">
    <register name="gptp"/>
    <register name="eplp"/>
  </prefersplit>

