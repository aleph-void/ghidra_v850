<dwarf>
  <!-- GCC DWARF register numbers 0-31 are r0-r31 (r3 sp, r4 gp, r5 tp, r30 ep, r31 lp).
       On entry the CFA is sp + 0 (the return address is in lp). -->
  <register_mappings>
    <register_mapping dwarf="0" ghidra="r0" auto_count="3"/>
    <register_mapping dwarf="3" ghidra="sp" stackpointer="true"/>
    <register_mapping dwarf="4" ghidra="gp"/>
    <register_mapping dwarf="5" ghidra="tp"/>
    <register_mapping dwarf="6" ghidra="r6" auto_count="24"/>
    <register_mapping dwarf="30" ghidra="ep"/>
    <register_mapping dwarf="31" ghidra="lp"/>
  </register_mappings>
  <call_frame_cfa value="0"/>
</dwarf>
