<opinions>
    <!-- EM_V800 (36, the RH850 ABI), EM_V850 (87) and the old EM_CYGNUS_V850 (0x9080).
         For EM_V850 the architecture is in e_flags bits 28-31 (6: V850E3V5 = RH850). -->
    <constraint loader="Executable and Linking Format (ELF)" compilerSpecID="default">
        <constraint primary="36" processor="RH850" endian="little" size="32" variant="default"/>
        <constraint primary="87" processor="RH850" endian="little" size="32" variant="default"
            secondary="0b0110 .... .... .... .... .... .... ...."/>
        <constraint primary="87" processor="RH850" endian="little" size="32" variant="V850E2M"
            secondary="0b0... .... .... .... .... .... .... ...."/>
        <constraint primary="36992" processor="RH850" endian="little" size="32" variant="V850E2M"/>
    </constraint>
</opinions>
