
# (13) Branch instructions
# part of (15) Special instructions


# JMP [reg1]
:jmp [R0004] is op0515=0x003 & R0004 & op0004=31 {
	PC = R0004;
	return [R0004];
}
:jmp [R0004] is op0515=0x003 & R0004 & op0004 != 31 {
	PC = R0004;
	goto [R0004];
}
# the indirect call GCC emits for V850E2 (no JARL [reg]): jarl .+4, lp; add 4, lp; jmp [reg]
:jmp [R0004] is icall=1 & op0515=0x003 & R0004 & op0004 != 31 {
	PC = R0004;
	call [R0004];
}

# JR disp32
:jr addr32 is op0015=0x02E0; op1616=0 ... & addr32 {
	PC = & addr32;
	goto addr32;
}

# JARL disp32, reg1
:jarl addr32, r0004 is op0515=0x017 & r0004; op1616=0 ... & addr32 {
	r0004 = inst_next;
	PC = & addr32;
	call addr32;
}

# JMP disp32[reg1]
:jmp addr32abs[R0004] is op0515=0x037 & R0004; op1616=0 ... & addr32abs {
	local addr = addr32abs + R0004;
	goto [addr];
}

# JR disp22
:jr addr22 is op0615=0x1E ... & addr22 {
	PC = & addr22;
	goto addr22;
}


# JARL .+4, lp: reads the PC (first instruction of GCC's V850E2 indirect call sequence)
:jarl addr22, lp is (op0610=0x1E & op1115=31 & s0005=0 & lp; op1631=4) & addr22
[ icall = 1; globalset(inst_next, icall); ] {
	lp = inst_next;
}
# ... add 4, lp passes the mark on to the jmp
:add s0004, R1115 is icall=1 & op0510=0x12 & s0004 & R1115 [ globalset(inst_next, icall); ] {
	local res = R1115 + s0004;
	flags_add (R1115, s0004);
	R1115 = res;
}
# JARL disp22, reg2
:jarl addr22, r1115 is (op0610=0x1E & r1115) ... & addr22 {
	r1115 = inst_next;
	PC = & addr22;
	call addr22;
}

macro pop(reg) { reg = *:4 sp; sp = sp + 4; }

# register list, shown in ascending order; restored from the stack lp first (lowest address)
DispL0: r20		is prep27=1 & r20	{ pop(r20); }
DispL0: 		is prep27=0	{ }
DispL1: r21		is prep26=1 & prep27=0 & r21	{ pop(r21); }
DispL1: DispL0,r21	is prep26=1 & DispL0 & r21	{ pop(r21); build DispL0; }
DispL1: DispL0		is prep26=0 & DispL0	{ build DispL0; }
DispL2: r22		is prep25=1 & prep27=0 & prep26=0 & r22	{ pop(r22); }
DispL2: DispL1,r22	is prep25=1 & DispL1 & r22	{ pop(r22); build DispL1; }
DispL2: DispL1		is prep25=0 & DispL1	{ build DispL1; }
DispL3: r23		is prep24=1 & prep27=0 & prep26=0 & prep25=0 & r23	{ pop(r23); }
DispL3: DispL2,r23	is prep24=1 & DispL2 & r23	{ pop(r23); build DispL2; }
DispL3: DispL2		is prep24=0 & DispL2	{ build DispL2; }
DispL4: r24		is prep31=1 & prep27=0 & prep26=0 & prep25=0 & prep24=0 & r24	{ pop(r24); }
DispL4: DispL3,r24	is prep31=1 & DispL3 & r24	{ pop(r24); build DispL3; }
DispL4: DispL3		is prep31=0 & DispL3	{ build DispL3; }
DispL5: r25		is prep30=1 & prep27=0 & prep26=0 & prep25=0 & prep24=0 & prep31=0 & r25	{ pop(r25); }
DispL5: DispL4,r25	is prep30=1 & DispL4 & r25	{ pop(r25); build DispL4; }
DispL5: DispL4		is prep30=0 & DispL4	{ build DispL4; }
DispL6: r26		is prep29=1 & prep27=0 & prep26=0 & prep25=0 & prep24=0 & prep31=0 & prep30=0 & r26	{ pop(r26); }
DispL6: DispL5,r26	is prep29=1 & DispL5 & r26	{ pop(r26); build DispL5; }
DispL6: DispL5		is prep29=0 & DispL5	{ build DispL5; }
DispL7: r27		is prep28=1 & prep27=0 & prep26=0 & prep25=0 & prep24=0 & prep31=0 & prep30=0 & prep29=0 & r27	{ pop(r27); }
DispL7: DispL6,r27	is prep28=1 & DispL6 & r27	{ pop(r27); build DispL6; }
DispL7: DispL6		is prep28=0 & DispL6	{ build DispL6; }
DispL8: r28		is prep23=1 & prep27=0 & prep26=0 & prep25=0 & prep24=0 & prep31=0 & prep30=0 & prep29=0 & prep28=0 & r28	{ pop(r28); }
DispL8: DispL7,r28	is prep23=1 & DispL7 & r28	{ pop(r28); build DispL7; }
DispL8: DispL7		is prep23=0 & DispL7	{ build DispL7; }
DispL9: r29		is prep22=1 & prep27=0 & prep26=0 & prep25=0 & prep24=0 & prep31=0 & prep30=0 & prep29=0 & prep28=0 & prep23=0 & r29	{ pop(r29); }
DispL9: DispL8,r29	is prep22=1 & DispL8 & r29	{ pop(r29); build DispL8; }
DispL9: DispL8		is prep22=0 & DispL8	{ build DispL8; }
DispL10: ep		is prep00=1 & prep27=0 & prep26=0 & prep25=0 & prep24=0 & prep31=0 & prep30=0 & prep29=0 & prep28=0 & prep23=0 & prep22=0 & ep	{ pop(ep); }
DispL10: DispL9,ep	is prep00=1 & DispL9 & ep	{ pop(ep); build DispL9; }
DispL10: DispL9		is prep00=0 & DispL9	{ build DispL9; }
DispL11: lp		is prep21=1 & prep27=0 & prep26=0 & prep25=0 & prep24=0 & prep31=0 & prep30=0 & prep29=0 & prep28=0 & prep23=0 & prep22=0 & prep00=0 & lp	{ pop(lp); }
DispL11: DispL10,lp	is prep21=1 & DispL10 & lp	{ pop(lp); build DispL10; }
DispL11: DispL10		is prep21=0 & DispL10	{ build DispL10; }
DispList: { DispL11 }	is DispL11	{ build DispL11; }



# DISPOSE imm5, list12
:dispose prep0105, DispList is prep0615=0x19 & prep1620=0 & prep0105 & DispList {
	sp = sp + (prep0105 << 2);
	build DispList;
}

# DISPOSE imm5, list12, [reg1] (GNU syntax: no brackets)
:dispose prep0105, DispList, prep1620r is prep0615=0x19 & prep1620r & prep0105 &  DispList {
	sp = sp + (prep0105 << 2);
	build DispList;
	PC = prep1620r;
	return [PC];
}


macro push(reg) { sp = sp - 4; *:4 sp = reg; }

PrepList20:	r20					is 				prep27=1 & r20			{	push(r20); }
PrepList20:						is 				prep27=0				{ }

PrepList21: r21					is prep26=1 & prep27=0 & r21			{	push(r21); }
PrepList21: PrepList20,r21		is prep26=1 & PrepList20 & r21			{	push(r21); }
PrepList21: PrepList20			is prep26=0 & PrepList20		 		{ }

PrepList22: r22					is prep25=1 & prep2627=0 & r22			{	push(r22); }
PrepList22: PrepList21,r22		is prep25=1 & PrepList21 & r22			{	push(r22); }
PrepList22: PrepList21			is prep25=0 & PrepList21		 		{ }

PrepList23: r23					is prep24=1 & prep2527=0 & r23			{	push(r23); }
PrepList23: PrepList22,r23		is prep24=1 & PrepList22 & r23			{	push(r23); }
PrepList23: PrepList22			is prep24=0 & PrepList22		 		{ }

PrepList24: r24					is prep31=1 & prep2427=0 & r24			{	push(r24); }
PrepList24: PrepList23,r24		is prep31=1 & PrepList23 & r24			{	push(r24); }
PrepList24: PrepList23			is prep31=0 & PrepList23		 		{ }

PrepList25: r25					is prep30=1 & prep2427=0 & prep31=0 & r25	{	push(r25); }
PrepList25: PrepList24,r25		is prep30=1 & PrepList24 & r25				{	push(r25); }
PrepList25: PrepList24			is prep30=0 & PrepList24					{ }

PrepList26: r26					is prep29=1 & prep2427=0 & prep3031=0 & r26	{	push(r26); }
PrepList26: PrepList25,r26		is prep29=1 & PrepList25 & r26				{	push(r26); }
PrepList26: PrepList25			is prep29=0 & PrepList25					{ }

PrepList27: r27					is prep28=1 & prep2427=0 & prep2931=0 & r27	{	push(r27); }
PrepList27: PrepList26,r27		is prep28=1 & PrepList26 & r27				{	push(r27); }
PrepList27: PrepList26			is prep28=0 & PrepList26					{ }

PrepList28: r28					is prep23=1 & prep2431=0 & r28				{	push(r28); }
PrepList28: PrepList27,r28		is prep23=1 & PrepList27 & r28				{	push(r28); }
PrepList28: PrepList27			is prep23=0 & PrepList27					{ }

PrepList29: r29					is prep22=1 & prep2431=0 & prep23=0 & r29	{	push(r29); }
PrepList29: PrepList28,r29		is prep22=1 & PrepList28 & r29				{	push(r29); }
PrepList29: PrepList28			is prep22=0 & PrepList28					{ }

PrepList30: ep					is prep00=1 & prep2431=0 & prep2223=0 & ep	{	push(ep); }
PrepList30: PrepList29,ep		is prep00=1 & PrepList29 & ep				{	push(ep); }
PrepList30: PrepList29			is prep00=0 & PrepList29		 			{ }

PrepList:	{ lp }				is prep21=1 & prep2431=0 & prep2223=0 & prep00=0 & lp {	push(lp); }
PrepList:	{ PrepList30,lp }	is prep21=1 & PrepList30 & lp				{	push(lp); }
PrepList:	{ PrepList30 }		is prep21=0 & PrepList30		 			{ }


# PREPARE list12, imm5
:prepare PrepList, prep0105 is prep0615=0x1E & prep0105 & prep1620=0x01 & PrepList {
	build PrepList;
	sp = sp - (prep0105 << 2);
}
# PREPARE list12, imm5, sp
:prepare PrepList, prep0105, sp is prep0615=0x1E & prep0105 & prep1620=0x03 & PrepList & sp {
	build PrepList;
	sp = sp - (prep0105 << 2);
	ep = sp;
}
# PREPARE list12, imm5, imm16 (low)
:prepare PrepList, prep0105, s3247 is prep0615=0x1E & prep0105 & prep1620=0x0B & PrepList; s3247 {
	build PrepList;
	sp = sp - (prep0105 << 2);
	ep = s3247;
}
# PREPARE list12, imm5, imm16 (high)
:prepare PrepList, prep0105, hi is prep0615=0x1E & prep0105 & prep1620=0x13 & PrepList; op3247
[ hi = op3247 << 16; ] {
	build PrepList;
	sp = sp - (prep0105 << 2);
	ep = hi;
}
# PREPARE list12, imm5, imm32
:prepare PrepList, prep0105, imm32 is prep0615=0x1E & prep0105 & prep1620=0x1B & PrepList; op3247; op4863
[ imm32 = (op4863 << 16) | op3247; ] {
	build PrepList;
	sp = sp - (prep0105 << 2);
	ep = imm32;
}



