# V850E3 (RH850) specific instructions
# got from gcc binutils sources
# RH850/U2A-EVA Group User's Manual: Hardware (RH850G4MH2 cores)
# RH850G3M User’s Manual: Software


# More special registers
define register offset=0x180 size=4 [
    # selID = 0
    # the same as common special regs in v850_common.sinc

    # selID = 1
    SPID SPIDLIST RBASE EBASE INTBP MCTL PID FPIPR
    SVLOCK SR9_1 TCSEL SCCFG SCBP HVCCFG HVCBP VSEL
    HVCFG GMCFG VMPRT2 SR19_1 HVSB SR21_1 SR22_1 VMSCCTL
    VMSCTBL0 VMSCTBL1 VMSCTBL2 VMSCTBL3 SR28_1 SR29_1 SR30_1 SR31_1

    # selID = 2
    PEID BMID SR2_2 SR3_2 SR4_2 HTCTL MEA ASID
    MEI SR9_2 ISPR PMR_IMSR ICSR INTCFG PLMR RBCR0
    RBCR1 RBNR RBIP SR19_2 SR20_2 SR21_2 SR22_2 HTSCCTL
    HTSCTBL0 HTSCTBL1 HTSCTBL2 HTSCTBL3 HTSCTBL4 HTSCTBL5 HTSCTBL6 HTSCTBL7

    # selID = 3
    SR0_3 SR1_3 SR2_3 SR3_3 SR4_3 SR5_3 SR6_3 SR7_3
    SR8_3 SR9_3 SR10_3 SR11_3 SR12_3 SR13_3 SR14_3 SR15_3
    SR16_3 SR17_3 SR18_3 SR19_3 SR20_3 SR21_3 SR22_3 SR23_3
    SR24_3 SR25_3 SR26_3 SR27_3 SR28_3 SR29_3 SR30_3 SR31_3

    # selID = 4 Cache operation registers
    TBLIDX SR1_4 SR2_4 SR3_4 TELO0 TELO1 TEHI0 TEHI1
    SR8_4 SR9_4 TBLCFG SR11_4 BWERRL BWERRH BRERRL BRERRH
    ICTAGL ICTAGH ICDATL ICDATH DCTAGL DCTAGH DCDATL DCDATH
    ICCTRL DCCTRL ICCFG DCCFG ICERR DCERR SR30_4 SR31_4

    # selID = 5, MPU registers
    MPM MPRC MPCFG SR3_5 MPBRGN MPTRGN SR6_5 SR7_5
    MCA MCS MCC MCR MCI SR13_5 SR14_5 SR15_5
    MPIDX MPBK SR18_5 SR19_5 MPLA MPUA MPAT SR23_5
    MPID0 MPID1 MPID2 MPID3 MPID4 MPID5 MPID6 MPID7

    # selID = 6, MPU registers
    MPLA0 MPUA0 MPAT0 SR3_6 MPLA1 MPUA1 MPAT1 SR7_6
    MPLA2 MPUA2 MPAT2 SR11_6 MPLA3 MPUA3 MPAT3 SR15_6
    MPLA4 MPUA4 MPAT4 SR19_6 MPLA5 MPUA5 MPAT5 SR23_6
    MPLA6 MPUA6 MPAT6 SR27_6 MPLA7 MPUA7 MPAT7 SR31_6

    # selID = 7, MPU registers
    MPLA8 MPUA8 MPAT8 SR3_7 MPLA9 MPUA9 MPAT9 SR7_7
    MPLA10 MPUA10 MPAT10 SR11_7 MPLA11 MPUA11 MPAT11 SR15_7
    MPLA12 MPUA12 MPAT12 SR19_7 MPLA13 MPUA13 MPAT13 SR23_7
    MPLA14 MPUA14 MPAT14 SR27_7 MPLA15 MPUA15 MPAT15 SR31_7

    # selID = 9, Guest Context registers
    GMEIPC GMEIPSW GMFEPC GMFEPSW SR4_9 GMPSW GMMEA SR7_9
    GMMEI SR9_9 SR10_9 SR11_9 SR12_9 GMEIIC GMFEIC SR15_9
    GMSPID GMSPIDLIST SR18_9 GMEBASE GMINTBP GMINTCFG GMPLMR SR23_9
    GMSVLOCK GMMPM SR26_9 SR27_9 GMEIWR GMFEWR GMEID SR31_9

    # selID = 10, Extended Floating-point Funtion (FXU) system registers
    SR0_10 SR1_10 SR2_10 SR3_10 SR4_10 SR5_10 FXSR SR7_10
    FXST FXINFO FXCFG SR11_10 FXXC FXXP SR14_10 SR15_10
    SR16_10 SR17_10 SR18_10 SR19_10 SR20_10 SR21_10 SR22_10 SR23_10
    SR24_10 SR25_10 SR26_10 SR27_10 SR28_10 SR29_10 SR30_10 SR31_10

    # selID = 11, Count function registers
    TSCOUNTL TSCOUNTH TSCTRL SR3_11 SR4_11 SR5_11 SR6_11 SR7_11
    PMUMCTRL PMGMCTRL SR10_11 SR11_11 SR12_11 SR13_11 SR14_11 SR15_11
    PMCOUNT0_11 PMCTRL0_11 PMCOUNT1_11 PMCTRL1_11 PMCOUNT2_11 PMCTRL2_11 PMCOUNT3_11 PMCTRL3_11
    SR24_11 SR25_11 SR26_11 SR27_11 SR28_11 SR29_11 SR30_11 SR31_11

    # selID = 12, Hardware function registers
    LSTEST0 LSTEST1 LSCFG SR3_12 IFCR SR5_12 SR6_12 SR7_12
    BRPCTRL0 SR9_12 SR10_12 SR11_12 SR12_12 SR13_12 SR14_12 SR15_12
    SR16_12 SR17_12 SR18_12 SR19_12 SR20_12 SR21_12 SR22_12 SR23_12
    SR24_12 SR25_12 SR26_12 SR27_12 SR28_12 SR29_12 SR30_12 SR31_12

    # selID = 13, Hardware function registers
    SR0_13 SR1_13 SR2_13 SR3_13 SR4_13 SR5_13 SR6_13 SR7_13
    SR8_13 SR9_13 SR10_13 SR11_13 L1CFG SR13_13 SR14_13 SR15_13
    SR16_13 SR17_13 SR18_13 SR19_13 SR20_13 SR21_13 SR22_13 SR23_13
    RDBCR SR25_13 SR26_13 SR27_13 SR28_13 SR29_13 SR30_13 SR31_13

    # selID = 14 Performance counters
    PMCTRL0_14 PMCTRL1_14 PMCTRL2_14 PMCTRL3_14 PMCTRL4_14 PMCTRL5_14 PMCTRL6_14 PMCTRL7_14
    SR8_14 SR9_14 SR10_14 SR11_14 SR12_14 SR13_14 SR14_14 SR15_14
    PMCOUNT0_14 PMCOUNT1_14 PMCOUNT2_14 PMCOUNT3_14 PMCOUNT4_14 PMCOUNT5_14 PMCOUNT6_14 PMCOUNT7_14
    SR24_14 SR25_14 SR26_14 SR27_14 SR28_14 SR29_14 SR30_14 SR31_14
	
    # selID = 15 Performance counters
    PMSUBCND0 PMSUBCND1 PMSUBCND2 PMSUBCND3 PMSUBCND4 PMSUBCND5 PMSUBCND6 PMSUBCND7
    SR8_15 SR9_15 SR10_15 SR11_15 SR12_15 SR13_15 SR14_15 SR15_15
    SR16_15 SR17_15 SR18_15 SR19_15 SR20_15 SR21_15 SR22_15 SR23_15
    SR24_15 SR25_15 SR26_15 SR27_15 SR28_15 SR29_15 SR30_15 SR31_15
	

    vr0  vr1  vr2  vr3  vr4  vr5  vr6  vr7
    vr8  vr9  vr10 vr11 vr12 vr13 vr14 vr15
    vr16 vr17 vr18 vr19 vr20 vr21 vr22 vr23
    vr24 vr25 vr26 vr27 vr28 vr29 vr30 vr31
];


