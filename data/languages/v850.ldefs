<?xml version="1.0" encoding="UTF-8"?>

<!-- Processor "RH850" (not "V850") so that these languages and their ELF opinions do not
     collide with the V850 module that ships with Ghidra. -->
<language_definitions>
  <language processor="RH850"
            endian="little"
            size="32"
            variant="default"
            version="0.1"
            slafile="v850e3.sla"
            processorspec="v850.pspec"
            manualindexfile="../manuals/v850.idx"
            id="RH850:LE:32:default">
    <description>Renesas RH850 / V850E3 (G3K, G3M, G3KH, G3MH, G4MH)</description>
    <compiler name="default" spec="v850.cspec" id="default"/>
    <external_name tool="gnu" name="v850e3v5"/>
  </language>
  <language processor="RH850"
            endian="little"
            size="32"
            variant="V850E2M"
            version="0.1"
            slafile="v850e2.sla"
            processorspec="v850.pspec"
            manualindexfile="../manuals/v850.idx"
            id="RH850:LE:32:V850E2M">
    <description>Renesas V850E2M</description>
    <compiler name="default" spec="v850.cspec" id="default"/>
    <external_name tool="gnu" name="v850e2v3"/>
  </language>
</language_definitions>
